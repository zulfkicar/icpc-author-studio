FROM python:3.13-slim-bookworm

LABEL org.opencontainers.image.title="ICPC Author Executor"
LABEL org.opencontainers.image.description="Isolated compiler/runner worker with no provider key and no external network"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/tmp

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        g++ \
        default-jdk-headless \
        latexmk \
        lmodern \
        texlive-latex-base \
        texlive-latex-recommended \
        texlive-latex-extra \
        texlive-fonts-recommended \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements-executor.txt .
RUN python -m pip install --no-cache-dir -r requirements-executor.txt

COPY executor_server.py .
COPY templates ./templates
COPY sandbox ./sandbox

RUN useradd --create-home --uid 1000 app \
    && mkdir -p /app/workspaces /tmp \
    && chown -R app:app /app /tmp

USER app

EXPOSE 8787

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8787/health', timeout=3)"]

CMD ["python", "executor_server.py", "--host", "0.0.0.0", "--port", "8787"]
